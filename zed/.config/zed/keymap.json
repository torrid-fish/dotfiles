    {
        "context": "Workspace",
        "bindings": {
            "ctrl-?": "agent::ToggleFocus",
        },
    },
    {
        "context": "(Editor && mode == full)",
        "bindings": {
            "alt-z": "editor::ToggleSoftWrap",
