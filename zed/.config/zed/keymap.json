    },
    {
        "context": "Workspace",
        "bindings": {
            "ctrl-alt-s": "multi_workspace::ToggleWorkspaceSidebar"
        }
    },
    {
        "context": "Workspace",
        "unbind": {
            "ctrl-alt-j": "multi_workspace::ToggleWorkspaceSidebar"
        }
    },
    {
        "context": "Workspace",
        "unbind": {
            "ctrl-alt-s": "workspace::SaveAll"
        }
    }
